APP_ENV=development
APP_NAME=SIHAT API
APP_VERSION=0.1.0
DEBUG=false
DATABASE_URL=postgresql+psycopg://sihat:sihat@localhost:5432/sihat
JWT_SECRET=REPLACE_WITH_A_RANDOM_32_CHARACTER_SECRET
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
ATTEMPT_TEMPORARY_HOURS=24
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_OAUTH_CLIENT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
PASSWORD_RESET_URL=http://localhost:5173/reset-password
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
