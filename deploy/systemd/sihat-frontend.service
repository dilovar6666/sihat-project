[Unit]
Description=SIHAT temporary static frontend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/dilovar/sihat/frontend/dist
ExecStart=/usr/bin/python3 -m http.server 8096 --bind 0.0.0.0 --directory /home/dilovar/sihat/frontend/dist
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=default.target
